# ================================================================
# API 密钥
#   只存 API key，不存模型名和 URL。
#   选择哪个模型请在 model_config.py 中修改。
#   修改示例：
#     1. 在下方填入你的 API key
#     2. 在 model_config.py 中设置 CHAT_MODEL 和 CHAT_BASE_URL
#     3. 系统自动根据 base_url 识别提供商并匹配对应的 API key
#    必填api：
#     1.会话模型
#     2.向量嵌入模型
#     3.mem0 记忆服务
# ================================================================

# 会话模型 API key（至少配置一个）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 向量嵌入模型 API key
EMBEDDING_API_KEY=your_embedding_api_key_here

# Mem0 记忆服务 API key
MEM0_API_KEY=your_mem0_api_key_here

# ================================================================
# 访问认证（可选，不配置则不需要认证）
# ================================================================

# 访问密钥 — 配置后前端需输入此密钥才能使用
# GIFTIA_ACCESS_KEY=your-secret-key

# 管理员密钥 — 用于访问日志、修改系统配置等敏感操作
# 如不配置但配置了 ACCESS_KEY，则 ACCESS_KEY 同时作为管理员密钥
# GIFTIA_ADMIN_KEY=your-admin-key

# ================================================================
# CORS 跨域配置（可选）
#   默认允许 localhost:3000，多个源用逗号分隔
# ================================================================
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
